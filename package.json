{
  "name": "typescript-build",
  "version": "0.0.0",
  "private": true,
  "description": "Bun + Turbo + TypeScript template with the validation and guardrails from auto-mobile",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:timing": "bun scripts/check-test-timing.ts",
    "typecheck": "tsc && tsc -p tsconfig.view.json",
    "types:emit": "tsc -p tsconfig.declarations.json && bun scripts/patch-declaration-imports.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "watch": "bun --watch src/index.ts",
    "build": "bun build.ts && bun run types:emit && chmod +x dist/src/index.js",
    "clean": "rm -rf dist coverage .turbo",
    "benchmark-npm-unpacked-size": "bun scripts/benchmark-npm-unpacked-size.ts",
    "benchmark-cli-startup": "bun scripts/benchmark-cli-startup.ts",
    "benchmark:perf": "bun scripts/benchmark-performance.ts",
    "coverage:check": "bun scripts/check-coverage-thresholds.ts",
    "package:quality": "bash scripts/validate-package-quality.sh",
    "scaffold:utility": "bun scripts/scaffold-utility.ts",
    "init:template": "bun scripts/init-template.ts",
    "docs:architecture": "bun scripts/generate-architecture-map.ts",
    "validate:architecture": "bun scripts/generate-architecture-map.ts --check",
    "validate:template": "bun scripts/validate-template-health.ts",
    "validate:fork": "bun scripts/validate-template-fork.ts",
    "prepublishOnly": "true",
    "postpublish": "true",
    "dead-code:ts": "knip",
    "validate:fast": "bash scripts/all_fast_validate_checks.sh",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "turbo:validate": "turbo run format:check lint lint:types typecheck build test validate:template coverage:check package:quality && turbo run benchmark:perf",
    "turbo:build": "turbo run build",
    "turbo:lint": "turbo run lint",
    "turbo:lint:types": "turbo run lint:types",
    "turbo:format:check": "turbo run format:check",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:test": "turbo run test",
    "turbo:benchmark:perf": "turbo run benchmark:perf"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5",
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/src/index.js",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "typescript-build": "./dist/src/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@oxlint/plugins": "^1.94.0",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.3",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.19",
    "js-yaml": "^5.5.0",
    "zod": "^4"
  }
}
