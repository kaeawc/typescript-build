{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "build.ts",
    "scripts/**/*.ts",
    "test/**/*.test.ts",
    "examples/**/*.ts",
    "src/mcp/apps/view/*.ts"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "examples/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "ignoreDependencies": ["@arethetypeswrong/cli", "publint"],
  "ignoreIssues": {
    "src/index.ts": ["exports", "types"],
    "src/composition.ts": ["files", "exports", "types"],
    "src/utils/**": ["exports", "types"],
    "test/contracts/**": ["exports", "types"],
    "test/fixtures/**": ["files", "exports", "types"],
    "examples/**": ["exports", "types"]
  }
}
