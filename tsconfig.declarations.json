{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Emits .d.ts files for the published package. JavaScript comes from build.ts.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage", "scratch", "test", "scripts", "examples"]
}
