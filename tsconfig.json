{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Single source of truth for type checking. Editors, `bun run typecheck`,
  // and type-aware oxlint (tsgolint) all read this file, so they report the same errors.
  // Emit is handled by build.ts (Bun bundler) + tsconfig.declarations.json.
  "compilerOptions": {
    // Environment: Bun runtime with Node-compatible APIs.
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["bun", "node"],

    // Modules: ESM-only, resolved the way Bun's bundler resolves them.
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,

    // Strictness beyond `strict`.
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "examples/**/*.ts", "build.ts"],
  "exclude": ["node_modules", "dist", "coverage", "scratch"]
}
